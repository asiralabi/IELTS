        <mxCell id="e2" value="contains" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#41525E;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#5A6C7D;strokeWidth=1.6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="chat_sessions" target="chat_messages"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="profiled by" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#41525E;startArrow=ERone;startFill=0;endArrow=ERone;endFill=0;strokeColor=#5A6C7D;strokeWidth=1.6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="users" target="weakness_profiles"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="requests" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#41525E;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#5A6C7D;strokeWidth=1.6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="users" target="generated_questions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="attempts" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#41525E;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#5A6C7D;strokeWidth=1.6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="users" target="practice_attempts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="submits" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#41525E;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#5A6C7D;strokeWidth=1.6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="users" target="writing_submissions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="submits" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#41525E;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#5A6C7D;strokeWidth=1.6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="users" target="speaking_submissions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="sits" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#41525E;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#5A6C7D;strokeWidth=1.6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="users" target="mock_exams"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="marked by" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#41525E;startArrow=ERone;startFill=0;endArrow=ERmany;endFill=0;strokeColor=#5A6C7D;strokeWidth=1.6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="generated_questions" target="practice_attempts"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="payload copied on pop()" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#41525E;startArrow=none;startFill=0;endArrow=blockThin;endFill=0;strokeColor=#6A9955;strokeWidth=1.6;labelBackgroundColor=#FFFFFF;dashed=1;endFill=1;" edge="1" parent="1" source="pre_generated_practice" target="generated_questions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="served set persisted as a row" style="edgeStyle=entityRelationEdgeStyle;rounded=0;html=1;fontSize=10;fontColor=#41525E;startArrow=none;startFill=0;endArrow=blockThin;endFill=0;strokeColor=#4E5D6C;strokeWidth=1.6;labelBackgroundColor=#FFFFFF;dashed=1;endFill=1;exitX=0;exitY=0.25;exitDx=0;exitDy=0;" edge="1" parent="1" source="cambridge_tests" target="generated_questions"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="n_pool" value="&lt;div style=&#x27;font-family:Helvetica;font-size:13px;font-weight:bold;color:#12212E&#x27;&gt;pre_generated_practice — warm pool&lt;/div&gt;&lt;div style=&#x27;height:8px&#x27;&gt;&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#22333F;line-height:15px&#x27;&gt;Index  ix_pool_available (section, question_type,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;difficulty, consumed_at)&lt;br&gt;&lt;br&gt;No FK. Rows are produced by the background warmer and&lt;br&gt;claimed with an atomic SELECT + UPDATE ... WHERE&lt;br&gt;consumed_at IS NULL (safe under SQLite write locking).&lt;br&gt;pop() = ~132 ms vs ~135 s cold generation.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#F1F8EE;strokeColor=#6A9955;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1360" y="320" width="380" height="161" as="geometry"/></mxCell>
        <mxCell id="n_camb" value="&lt;div style=&#x27;font-family:Helvetica;font-size:13px;font-weight:bold;color:#12212E&#x27;&gt;cambridge_tests — reference corpus&lt;/div&gt;&lt;div style=&#x27;height:8px&#x27;&gt;&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#22333F;line-height:15px&#x27;&gt;Unique  uq_cambridge_book_test (book_id, test_number)&lt;br&gt;&lt;br&gt;No FK: a static library parsed from the Cambridge PDFs&lt;br&gt;(77 rows, books 1-21). Grounding + a browsable picker,&lt;br&gt;never rendered raw to a student.&lt;br&gt;&lt;br&gt;Gap: no sample answers or examiner bands are parsed,&lt;br&gt;which blocks the writing + speaking evaluators.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#F2F4F6;strokeColor=#4E5D6C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1360" y="660" width="380" height="176" as="geometry"/></mxCell>
        <mxCell id="n_legend" value="&lt;div style=&#x27;font-family:Helvetica;font-size:13px;font-weight:bold;color:#12212E&#x27;&gt;Legend&lt;/div&gt;&lt;div style=&#x27;height:8px&#x27;&gt;&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#22333F;line-height:15px&#x27;&gt;PK   primary key          ERone   exactly one&lt;br&gt;FK   foreign key          ERmany  zero or more&lt;br&gt;U    unique constraint&lt;br&gt;idx  indexed column&lt;br&gt;&lt;br&gt;Solid line  = database-enforced foreign key&lt;br&gt;Dashed line = data copied in application code,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;no referential constraint&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#FFFFFF;strokeColor=#8FA3B4;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1360" y="90" width="380" height="176" as="geometry"/></mxCell>
        <mxCell id="n_orm" value="&lt;div style=&#x27;font-family:Helvetica;font-size:13px;font-weight:bold;color:#12212E&#x27;&gt;ORM relationships vs bare FKs&lt;/div&gt;&lt;div style=&#x27;height:8px&#x27;&gt;&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#22333F;line-height:15px&#x27;&gt;back_populates is declared only for:&lt;br&gt;&amp;nbsp;&amp;nbsp;users -&amp;gt; chat_sessions -&amp;gt; chat_messages&lt;br&gt;&amp;nbsp;&amp;nbsp;users -&amp;gt; writing_submissions&lt;br&gt;&amp;nbsp;&amp;nbsp;users -&amp;gt; speaking_submissions&lt;br&gt;&lt;br&gt;generated_questions, practice_attempts, mock_exams&lt;br&gt;and weakness_profiles carry the FK column but no ORM&lt;br&gt;relationship - they are queried explicitly.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#FFF8F0;strokeColor=#C55A11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1360" y="1040" width="380" height="176" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="erd-json" name="2 · JSON Column Schemas">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2020" pageHeight="1533" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="t2" value="JSON Column Schemas" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=24;fontStyle=1;fontColor=#12212E;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="900" height="34" as="geometry"/></mxCell>
        <mxCell id="t2s" value="Most of the domain model lives inside JSON columns. These are the shapes the LLM prompts contract for and the validators enforce." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=12;fontStyle=0;fontColor=#5A6C7D;" vertex="1" parent="1"><mxGeometry x="40" y="54" width="1400" height="22" as="geometry"/></mxCell>
        <mxCell id="d_read" value="&lt;div style=&#x27;font-family:Helvetica;font-size:13px;font-weight:bold;color:#12212E&#x27;&gt;generated_questions.payload  ·  section = &#x27;reading&#x27;&lt;/div&gt;&lt;div style=&#x27;height:8px&#x27;&gt;&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#22333F;line-height:15px&#x27;&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;title&quot;:   str,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;passage&quot;: str,                 // 650-900 words, paragraphs labelled A, B, C...&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;visual&quot;:  Visual | null,       // table only (reading has no map renderer)&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;questions&quot;: [&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{ &quot;number&quot;:     int,          // sequential from 1, passage order within a block&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;type&quot;:       QType,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;question&quot;:   str,          // self-contained, repeats its own rubric&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;options&quot;:    [str] | null, // REQUIRED on every matching_* / multiple_choice&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;word_limit&quot;: int }         // gap-fill types only&lt;br&gt;&amp;nbsp;&amp;nbsp;],&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;answer_key&quot;: { &quot;&amp;lt;n&amp;gt;&quot;: str }&lt;br&gt;}&lt;br&gt;&lt;br&gt;QType = true_false_notgiven | yes_no_notgiven | matching_headings&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;| matching_information | matching_features | matching_sentence_endings&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;| multiple_choice | sentence_completion | summary_completion&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;| note_completion | table_completion | flow_chart_completion&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;| short_answer&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#F1F8F2;strokeColor=#2F6B37;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="620" height="341" as="geometry"/></mxCell>
        <mxCell id="d_listen" value="&lt;div style=&#x27;font-family:Helvetica;font-size:13px;font-weight:bold;color:#12212E&#x27;&gt;generated_questions.payload  ·  section = &#x27;listening&#x27;&lt;/div&gt;&lt;div style=&#x27;height:8px&#x27;&gt;&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#22333F;line-height:15px&#x27;&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;blueprint&quot;: {                  // designed before the script is written&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;section&quot;: &quot;Part 1|2|3|4&quot;,  &quot;topic&quot;: str,  &quot;difficulty&quot;: str,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;register&quot;: str,            &quot;question_type_plan&quot;: [str],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;distractor_strategy&quot;: str, &quot;answer_distribution&quot;: str },&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;title&quot;:        str,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;audio_script&quot;: str,            // 1200-1500 words, speaker-labelled&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;speakers&quot;: [                   // acting directions consumed by the TTS engine&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{ &quot;label&quot;:   str,             // matches a script label character-for-character&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;gender&quot;:  &quot;female|male&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;accent&quot;:  &quot;British|American|Australian&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;persona&quot;: str, &quot;wpm&quot;: int, &quot;pause_ms&quot;: int } ],&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;visual&quot;:    Visual | null,     // table OR map&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;questions&quot;: [ ... same object shape as reading ... ],&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;answer_key&quot;:        { &quot;&amp;lt;n&amp;gt;&quot;: str },&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;accepted_variants&quot;: { &quot;&amp;lt;n&amp;gt;&quot;: [str] },   // digit/word, spelling, abbreviation&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;answer_positions&quot;:  { &quot;&amp;lt;n&amp;gt;&quot;: str }      // verbatim script anchor, ascending&lt;br&gt;}&lt;br&gt;&lt;br&gt;QType = form_completion | note_completion | table_completion | matching&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;| flow_chart_completion | summary_completion | multiple_choice&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;| map_labelling | sentence_completion | short_answer&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#F1F8F2;strokeColor=#2F6B37;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="700" y="110" width="620" height="386" as="geometry"/></mxCell>
        <mxCell id="d_vis_chart" value="&lt;div style=&#x27;font-family:Helvetica;font-size:13px;font-weight:bold;color:#12212E&#x27;&gt;Visual  ·  kind = &#x27;chart&#x27;&lt;/div&gt;&lt;div style=&#x27;height:8px&#x27;&gt;&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#22333F;line-height:15px&#x27;&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;kind&quot;:       &quot;chart&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;chart_type&quot;: &quot;bar&quot; | &quot;line&quot; | &quot;pie&quot; | &quot;table&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;title&quot;:      str,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;x_label&quot;:    str,              // omit for pie&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;y_label&quot;:    str,              // omit for pie / table&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;series&quot;: [ { &quot;name&quot;: str, &quot;data&quot;: [[str, num | str], ...] } ]&lt;br&gt;}&lt;br&gt;&lt;br&gt;bar / line : 1-4 series sharing the same 4-8 categories, in order&lt;br&gt;pie        : exactly 1 series, 4-6 slices summing to a plausible whole&lt;br&gt;table      : 1 series per row; name = row label, data = [header, cell]&lt;br&gt;&lt;br&gt;Table completion: a cell the student must fill is the literal&lt;br&gt;string &quot;__&amp;lt;n&amp;gt;__&quot;, where &amp;lt;n&amp;gt; matches the answer_key numbering.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#F5F2FA;strokeColor=#7030A0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1360" y="110" width="620" height="281" as="geometry"/></mxCell>
        <mxCell id="d_vis_map" value="&lt;div style=&#x27;font-family:Helvetica;font-size:13px;font-weight:bold;color:#12212E&#x27;&gt;Visual  ·  kind = &#x27;map&#x27;   (listening only)&lt;/div&gt;&lt;div style=&#x27;height:8px&#x27;&gt;&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#22333F;line-height:15px&#x27;&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;kind&quot;:   &quot;map&quot;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;title&quot;:  str,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;width&quot;:  int,                  // 10-14 integer grid, (0,0) is bottom-left&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;height&quot;: int,                  // 8-12&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;features&quot;: [&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{ &quot;label&quot;: str,               // &quot;A&quot;..&quot;H&quot;, or a landmark word when fixed&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;x&quot;: int, &quot;y&quot;: int,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;fixed&quot;: bool,              // true = orientation landmark, not an answer&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;shape&quot;: &quot;room&quot; } ],&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;paths&quot;: [ { &quot;points&quot;: [[x, y], ...], &quot;label&quot;: str } ]&lt;br&gt;}&lt;br&gt;&lt;br&gt;6-8 lettered rooms + 2-4 fixed landmarks. Every (x, y) unique and&lt;br&gt;&amp;gt;= 2 units apart. answer_key holds the LETTER; map_labelling&lt;br&gt;questions carry no options array.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#F5F2FA;strokeColor=#7030A0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="477" width="620" height="296" as="geometry"/></mxCell>
        <mxCell id="d_attempt" value="&lt;div style=&#x27;font-family:Helvetica;font-size:13px;font-weight:bold;color:#12212E&#x27;&gt;practice_attempts.result   ·   mock_exams.results.{listening,reading}&lt;/div&gt;&lt;div style=&#x27;height:8px&#x27;&gt;&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#22333F;line-height:15px&#x27;&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;score&quot;:         int,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;total&quot;:         int,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;band_estimate&quot;: float,         // raw score scaled to the 40-question band table&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;results&quot;: [&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{ &quot;number&quot;:         int,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;correct&quot;:        bool,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;student_answer&quot;: str,      // &quot;&quot; when left blank&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;correct_answer&quot;: str,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;explanation&quot;:    str,      // what misled the student, not just the answer&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;skill&quot;:          str }     // listening only, from the per-question evaluator&lt;br&gt;&amp;nbsp;&amp;nbsp;]&lt;br&gt;}&lt;br&gt;&lt;br&gt;Reading marks in ONE bulk call (ANSWER_CHECKER_SYSTEM).&lt;br&gt;Listening marks per question, after a deterministic _norm pre-pass&lt;br&gt;settles blank / exact / listed-variant answers without the LLM.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#FFF7F0;strokeColor=#C55A11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="700" y="522" width="620" height="311" as="geometry"/></mxCell>
        <mxCell id="d_writing" value="&lt;div style=&#x27;font-family:Helvetica;font-size:13px;font-weight:bold;color:#12212E&#x27;&gt;writing_submissions.result   ·   mock_exams.results.writing.*&lt;/div&gt;&lt;div style=&#x27;height:8px&#x27;&gt;&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#22333F;line-height:15px&#x27;&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;band_score&quot;:                       float,   // 0-9 in 0.5 steps&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;task_response_score&quot;:              float,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;coherence_cohesion_score&quot;:         float,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;lexical_resource_score&quot;:           float,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;grammatical_range_accuracy_score&quot;: float,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;strengths&quot;:  [str],&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;weaknesses&quot;: [str],&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;errors&quot;: [&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{ &quot;excerpt&quot;: str,               // verbatim from the script&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;issue&quot;: str, &quot;correction&quot;: str } ],&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;improved_sentences&quot;: [&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;{ &quot;original&quot;: str, &quot;improved&quot;: str } ],&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;feedback&quot;:             str,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;estimated_final_band&quot;: float&lt;br&gt;}&lt;br&gt;&lt;br&gt;band_score is mirrored into the writing_submissions.band_score column.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#FFF7F0;strokeColor=#BF6000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1360" y="417" width="620" height="326" as="geometry"/></mxCell>
        <mxCell id="d_speaking" value="&lt;div style=&#x27;font-family:Helvetica;font-size:13px;font-weight:bold;color:#12212E&#x27;&gt;speaking_submissions.result   ·   mock_exams.results.speaking.*&lt;/div&gt;&lt;div style=&#x27;height:8px&#x27;&gt;&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#22333F;line-height:15px&#x27;&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;band_score&quot;:                       float,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;fluency_coherence_score&quot;:          float,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;lexical_resource_score&quot;:           float,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;grammatical_range_accuracy_score&quot;: float,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;pronunciation_score&quot;:              float | null,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;strengths&quot;:  [str],&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;weaknesses&quot;: [str],&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;feedback&quot;:   str&lt;br&gt;}&lt;br&gt;&lt;br&gt;KNOWN GAP: pronunciation_score is always null in production -&lt;br&gt;speaking_examiner.py never extracts audio features, so the criterion&lt;br&gt;is excluded from the average rather than estimated.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#FFF7F0;strokeColor=#BF6000;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="799" width="620" height="266" as="geometry"/></mxCell>
        <mxCell id="d_exam" value="&lt;div style=&#x27;font-family:Helvetica;font-size:13px;font-weight:bold;color:#12212E&#x27;&gt;mock_exams.exam&lt;/div&gt;&lt;div style=&#x27;height:8px&#x27;&gt;&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#22333F;line-height:15px&#x27;&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;listening&quot;: &amp;lt;listening payload&amp;gt;,      // full set, incl. answer_key&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;reading&quot;:   &amp;lt;reading payload&amp;gt;,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;writing&quot;: {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;task1&quot;: { question, visual, question_type, ... },&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;task2&quot;: { question, task2_type, ... } },&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;speaking&quot;: {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;part1&quot;: [ { &quot;topic&quot;: str, &quot;questions&quot;: [str x4] } x3 ],&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;part2&quot;: { &quot;topic&quot;: str, &quot;bullets&quot;: [str x3], &quot;closing&quot;: str },&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;part3&quot;: [ { question, ... } ] }&lt;br&gt;}&lt;br&gt;&lt;br&gt;All seven sections are generated concurrently by asyncio.gather.&lt;br&gt;GET /mock-exam/{id} recursively strips answer_key, answers and&lt;br&gt;explanation until status == &#x27;scored&#x27;.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#F7F2FB;strokeColor=#7030A0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="700" y="859" width="620" height="281" as="geometry"/></mxCell>
        <mxCell id="d_results" value="&lt;div style=&#x27;font-family:Helvetica;font-size:13px;font-weight:bold;color:#12212E&#x27;&gt;mock_exams.results&lt;/div&gt;&lt;div style=&#x27;height:8px&#x27;&gt;&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#22333F;line-height:15px&#x27;&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;listening&quot;: &amp;lt;attempt result&amp;gt; | null,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;reading&quot;:   &amp;lt;attempt result&amp;gt; | null,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;writing&quot;:  { &quot;task1&quot;: &amp;lt;writing result&amp;gt;, &quot;task2&quot;: &amp;lt;writing result&amp;gt; },&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;speaking&quot;: { &quot;part1&quot;: &amp;lt;speaking result&amp;gt;, &quot;part2&quot;: ..., &quot;part3&quot;: ... },&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;section_bands&quot;: {&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;listening&quot;: float,   &quot;reading&quot;:  float,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;writing&quot;:   float,   // official weighting: (task1 + 2 x task2) / 3&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;speaking&quot;:  float }, // mean of the submitted parts&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;overall_band&quot;: float | null   // mean of section_bands, half-band rounded&lt;br&gt;}&lt;br&gt;&lt;br&gt;overall_band is also written to the mock_exams.overall_band column&lt;br&gt;and status flips to &#x27;scored&#x27; (re-submission returns 409).&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#F7F2FB;strokeColor=#7030A0;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1360" y="769" width="620" height="266" as="geometry"/></mxCell>
        <mxCell id="d_camb" value="&lt;div style=&#x27;font-family:Helvetica;font-size:13px;font-weight:bold;color:#12212E&#x27;&gt;cambridge_tests.{reading, listening, writing, speaking}&lt;/div&gt;&lt;div style=&#x27;height:8px&#x27;&gt;&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#22333F;line-height:15px&#x27;&gt;reading = {&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;page_range&quot;: [int, int],  &quot;raw_text&quot;: str,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;passages&quot;: [ { &quot;n&quot;: int, &quot;title&quot;: str, &quot;text&quot;: str,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;question_blocks&quot;: [...], &quot;visuals&quot;: [...] } ],&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;answer_key&quot;: { &quot;&amp;lt;n&amp;gt;&quot;: str } }&lt;br&gt;&lt;br&gt;listening = {&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;page_range&quot;: [int, int],  &quot;raw_text&quot;: str,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;parts&quot;: [ { &quot;n&quot;: int, &quot;question_blocks&quot;: [...] } ],&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;answer_key&quot;: { &quot;&amp;lt;n&amp;gt;&quot;: str } }&lt;br&gt;&lt;br&gt;writing  = { page_range, raw_text,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;tasks&quot;: [ { &quot;n&quot;: int, &quot;prompt&quot;: str, &quot;visuals&quot;: [...] } ] }&lt;br&gt;&lt;br&gt;speaking = { page_range, raw_text,&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&quot;parts&quot;: [ { &quot;n&quot;: int, &quot;text&quot;: str } ] }&lt;br&gt;&lt;br&gt;warnings = [str]     // per-test parser complaints, surfaced not swallowed&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#F2F4F6;strokeColor=#4E5D6C;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="40" y="1091" width="620" height="326" as="geometry"/></mxCell>
        <mxCell id="d_weak" value="&lt;div style=&#x27;font-family:Helvetica;font-size:13px;font-weight:bold;color:#12212E&#x27;&gt;weakness_profiles.profile&lt;/div&gt;&lt;div style=&#x27;height:8px&#x27;&gt;&lt;/div&gt;&lt;div style=&#x27;font-family:Consolas,monospace;font-size:11px;color:#22333F;line-height:15px&#x27;&gt;{&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;grammar&quot;:               bool,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;vocabulary&quot;:            bool,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;coherence&quot;:             bool,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;pronunciation&quot;:         bool,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;fluency&quot;:               bool,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;task_response&quot;:         bool,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;reading_comprehension&quot;: bool,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;listening_accuracy&quot;:    bool,&lt;br&gt;&amp;nbsp;&amp;nbsp;&quot;details&quot;: { &quot;&amp;lt;criterion&amp;gt;&quot;: str }   // one evidence sentence per criterion,&lt;br&gt;}                                     // whether true or false&lt;br&gt;&lt;br&gt;A criterion is true only on a recurring pattern across sessions,&lt;br&gt;never a one-off slip. With no data for a criterion it is false and&lt;br&gt;details says &quot;insufficient data&quot;.&lt;/div&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=10;fillColor=#FAF2F8;strokeColor=#A0338E;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="700" y="1166" width="620" height="281" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
