# Container configuration for docker-compose.yml.
#
#   cp .env.docker.example .env.docker   (or: bash scripts/env-for-docker.sh)
#
# This file replaces backend/.env inside the container — pydantic reads real
# environment variables, and backend/.env is never copied into the image.

# --- Application ---
DEBUG=false

# --- Auth ---
# REQUIRED. The server refuses to start on the placeholder, because a token
# signed with a value that ships in git can be forged by anyone. Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# --- LLM: one hosted model serves every module ---
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
# gpt-oss is a reasoning model: it thinks out of the same budget it writes
# from, so a small max-tokens returns EMPTY content rather than a short answer.
OPENAI_REASONING_EFFORT=medium
LLM_MAX_TOKENS=16384
LLM_TEMPERATURE=0.4
LLM_TIMEOUT=600

# Blank on purpose. These name fine-tuned checkpoints served by a local ollama,
# which does not exist in the container; blank falls back to the hosted model.
GENERATOR_MODEL=
EVALUATOR_MODEL=

# --- Speaking transcription ---
# 🔬 Measured 2026-09-03 in this container, one 20s clip, int8 on CPU:
#
#   large-v3   OOM-KILLED at 2.90GB (exit 137) — did not finish
#   medium.en  95s, 2.74GB resident, transcript verbatim
#   small.en   28s, 1.33GB resident, transcript verbatim
#
# small.en is the default because Speaking has to WORK. large-v3 is what the
# system design specifies and is the better transcriber on accented or noisy
# speech — the three above agree only because the probe was clean synthetic
# speech. Move up when the container has the memory: medium.en needs ~3GB to
# itself, large-v3 ~4GB, and the app needs ~600MB underneath either.
WHISPER_MODEL=small.en
WHISPER_COMPUTE_TYPE=int8

# --- Browser access control ---
# Comma-separated origins allowed to call the API, or * for any. Behind the
# bundled proxy the page and the API share an origin, so the browser sends no
# cross-origin request at all and this is unused. It matters only when the
# frontend is served from a DIFFERENT origin than the backend — then name that
# origin here instead of leaving it open to every site on the internet.
CORS_ORIGINS=*
