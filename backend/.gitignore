# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Environments
.venv/
venv/
env/
.env

# Project data (large: sqlite DB, extracted assets, tts cache, qdrant store) —
# kept out of git, EXCEPT the fine-tuning SFT datasets, which are committed so
# they clone straight into Kaggle for the QLoRA notebooks.
data/*
!data/datasets/
data/datasets/*
!data/datasets/*.jsonl

# Source material: huge + copyrighted Cambridge PDFs, audio CDs, screen
# recordings. Grounding/training input only — never published (north-star).
books/
Audios/

# Browser-verification screenshot artifacts (regenerated by tools/browser_*.py)
tools/browser_shots/
tools/student_walkthrough/
# Cambridge pages rendered by tools/cambridge_figure_atlas.py — regenerate
# them from the books rather than carrying 233 scans in the repo.
tools/_atlas/
# Scratch output from the sweeps, corpus runs and render probes. Every tool in
# `tools/` writes its working files under a leading underscore precisely so one
# rule covers them: sweep logs, saved figure galleries, sample audio, corpus
# dumps. They are evidence for one session, regenerated by re-running the tool,
# and `_gallery/` alone is tens of megabytes of JSON.
tools/_*
# ...except the seed fixture, which IS source: the sweep and the audit are
# both seeded against it.
!tools/_seed*.json

# Backups of the env file. `.env` is ignored above; a copy of it is still the
# same secrets under a different name.
.env.backup*
.env.*.backup

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
.vercel
